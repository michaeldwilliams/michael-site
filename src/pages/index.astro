---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Michael — iOS Engineering Lead">
  <h1 class="text-3xl font-semibold mb-4">Michael</h1>
  <p class="text-lg mb-6">iOS Engineering Lead building scalable, reliable mobile apps.</p>

  <ul class="list-disc pl-5 space-y-2 text-gray-700">
    <li>Leads iOS development for a high-scale QSR app</li>
    <li>UIKit → SwiftUI migrations without rewrites</li>
    <li>Architecture, testability, and long-term maintainability</li>
    <li>Pragmatic about tools and tech choices</li>
  </ul>
</BaseLayout>
