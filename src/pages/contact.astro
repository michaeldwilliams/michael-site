---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact">
  <h1 class="text-2xl font-semibold mb-4">Contact</h1>
  <ul class="space-y-2">
    <li><a href="https://github.com/<your-username>" class="text-blue-600">GitHub</a></li>
    <li><a href="https://linkedin.com/in/<your-handle>" class="text-blue-600">LinkedIn</a></li>
    <li>Email: michael [at] example [dot] com</li>
  </ul>
</BaseLayout>
